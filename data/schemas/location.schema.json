{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["id", "name", "default_scene", "scenes"],
    "definitions": {
        "requirement": {
            "type": "object",
            "required": ["type", "key"],
            "properties": {
                "type": { "enum": ["Flag", "Skill", "Counter", "Feat", "Item", "Standing"] },
                "key": { "type": "string" },
                "min": { "type": "integer" },
                "max": { "type": "integer" },
                "expected": { "type": "boolean" }
            }
        },
        "effect": {
            "type": "object",
            "required": ["type", "key"],
            "properties": {
                "type": { "enum": ["Flag", "Skill", "Counter", "Feat", "Item", "Standing"] },
                "key": { "type": "string" },
                "delta": { "type": "integer" },
                "flagValue": { "type": "boolean" }
            }
        }
    },
    "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "default_scene": { "type": "string" },
        "scenes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name", "variants", "options", "connections"],
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "variants": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["description", "art"],
                            "properties": {
                                "requirements": { "type": "array", "items": { "$ref": "#/definitions/requirement" } },
                                "description": { "type": "string" },
                                "art": { "type": "string" }
                            }
                        }
                    },
                    "options": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["label", "type", "target_id"],
                            "properties": {
                                "label": { "type": "string" },
                                "type": { "enum": ["Dialogue", "Action"] },
                                "target_id": { "type": "string" },
                                "requirements": { "type": "array", "items": { "$ref": "#/definitions/requirement" } },
                                "effects": { "type": "array", "items": { "$ref": "#/definitions/effect" } }
                            }
                        }
                    },
                    "connections": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["label", "destination_location", "destination_scene"],
                            "properties": {
                                "label": { "type": "string" },
                                "destination_location": { "type": "string" },
                                "destination_scene": { "type": "string" },
                                "requirements": { "type": "array", "items": { "$ref": "#/definitions/requirement" } },
                                "effects": { "type": "array", "items": { "$ref": "#/definitions/effect" } }
                            }
                        }
                    }
                }
            }
        }
    }
}
